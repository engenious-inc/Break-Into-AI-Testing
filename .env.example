GROQ_API_KEY=gsk-replace-me

# Fallback only — enables promptfooconfig.openrouter.medibot.yaml (and .openrouter.finance.yaml) when Groq is down/throttled.
# Your instructor shares the cohort OpenRouter key; paste it here when you need it.
# OPENROUTER_API_KEY=sk-or-...

# Optional — enables the GPT comparison block in promptfooconfig.medibot.yaml (paid).
# OPENAI_API_KEY=sk-replace-me

# Optional — enables the Claude comparison block in promptfooconfig.medibot.yaml (paid).
# ANTHROPIC_API_KEY=sk-ant-replace-me

# Optional — enables real Arato.ai monitoring in modules/02-advanced-eval/observability/.
# Both must be set or the lesson prints a "skipped" line and carries on.
# Replace <your-project> with your Arato project slug — copy the exact URL from
# your Arato account, this is the documented shape, not a guaranteed path.
# ARATO_API_URL=https://api.arato.ai/<your-project>/log
# ARATO_API_KEY=ar-...

# Optional — telemetry privacy switch for the observability lesson.
# Default (unset/false): Arato receives a SHA-256 hash + length, never your text.
# Set to true only when you need to read raw prompts back in Arato's UI.
# LOG_RAW_PROMPTS=false
