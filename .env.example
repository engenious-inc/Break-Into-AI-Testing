GROQ_API_KEY=gsk-replace-me

# Fallback only — enables promptfooconfig.openrouter.medibot.yaml (and .openrouter.finance.yaml) when Groq is down/throttled.
# Your instructor shares the cohort OpenRouter key; paste it here when you need it.
# OPENROUTER_API_KEY=sk-or-...

# Optional — enables the GPT comparison block in promptfooconfig.medibot.yaml (paid).
# OPENAI_API_KEY=sk-replace-me

# Optional — enables the Claude comparison block in promptfooconfig.medibot.yaml (paid).
# ANTHROPIC_API_KEY=sk-ant-replace-me

# Optional — enables real Arato.ai monitoring for the Day 8 observability lesson
# (TutorBot eval) and for PayFlow's POST /chat spans. Both must be set or the
# lesson prints a "skipped" line and carries on.
# Get both from Arato: Observe -> your dashboard -> "Monitor With Arato".
# The endpoint already contains your project slug; do not add /v1/traces, the
# exporter appends it.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://api.arato.ai/opentelemetry/<your-project>
# ARATO_API_KEY=ar-...
# OTEL_SERVICE_NAME=break-into-ai-testing

# Optional — Agenta cloud (free). Same OTLP protobuf as Arato; TutorBot and
# PayFlow both export here when this is set. AGENTA_HOST only if you are not
# on EU cloud.
# AGENTA_API_KEY=...
# AGENTA_HOST=https://eu.cloud.agenta.ai

# Optional — telemetry privacy switch for TutorBot and PayFlow spans.
# Default (unset/false): the backend receives a SHA-256 hash + length, never your text.
# Set to true only when you need to read raw prompts back in the UI.
# LOG_RAW_PROMPTS=false
